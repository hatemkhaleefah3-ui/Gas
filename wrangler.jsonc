{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dafati-campusly",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "dafati-campusly", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }],
  "kv_namespaces": [{ "binding": "PROFILE_PHOTOS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
